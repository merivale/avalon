{
  "lock": false,
  "tasks": {
    "start": "deno run --watch --allow-net --allow-env --allow-read --unstable-kv main.ts",
    "check": "deno check client && deno check core && deno check server && deno check ui && deno check main.ts",
    "lint": "deno fmt --check && deno lint",
    "lint:fix": "deno fmt && deno lint --fix",
    "test:core": "deno test core/",
    "test": "deno task test:core"
  },
  "imports": {
    "@/": "./",
    "@std/assert": "jsr:@std/assert@1.0.16",
    "@std/testing": "jsr:@std/testing@1.0.16",
    "preact": "npm:preact@^10.27.2",
    "preact-render-to-string": "npm:preact-render-to-string@^6.6.3"
  },
  "compilerOptions": {
    "lib": ["dom", "esnext", "deno.ns", "deno.unstable"],
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "jsx": "precompile",
    "jsxImportSource": "preact"
  }
}
